{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "5236c541867f4fafba4425517b8119d6",
    "m_Title": "",
    "m_Content": "Calcula en qué parte de la ola debería estar cada vértice\n\nPosition → dónde está el vértice.\nDirection → hacia dónde viaja la ola.\nFrequency → qué tan juntas están las olas.\nTime * Speed → cuánto avanzó la ola con el tiempo.\n\nEse resultado se lo pasa al Sine y al Cosine, que son los que dibujan la forma de la ola.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -4114.0,
        "y": 320.0,
        "width": 287.0,
        "height": 175.0
    },
    "m_Group": {
        "m_Id": "0195fba33cb944a1a0386aceda608f36"
    }
}

